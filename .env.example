# Connection string do Neon (na Vercel é criada pela integração Neon).
# Sem ela, `npm run dev` usa um Postgres local em .pglite/
DATABASE_URL=

# Assina as sessões. Em desenvolvimento há um valor padrão; em produção é obrigatório.
AUTH_SECRET=
# Código para o administrador criar/recuperar a senha na tela de login.
ADMIN_RECOVERY_CODE=
# Notificações push (npx web-push generate-vapid-keys). Sem elas, as notificações ficam desligadas.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://barbearia-dennis-eosin.vercel.app
